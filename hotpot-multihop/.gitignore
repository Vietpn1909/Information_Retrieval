# Môi trường & cache Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# Hệ điều hành / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Dữ liệu sinh ra (~270 MB) — tạo lại bằng scripts/build_corpus.py và scripts/build_index.py
data/*
!data/.gitkeep

# Kết quả chạy: run file TREC ~40 MB/file và log tqdm → không commit.
# Chỉ giữ bảng kết quả nhỏ (CSV/JSON/MD) làm minh chứng — áp dụng cho MỌI runs/<phần>/,
# nên thành viên mới không cần sửa file này.
runs/*
!runs/.gitkeep
!runs/*.json
!runs/*/
runs/*/*
!runs/*/*.csv
!runs/*/*.json
!runs/*/*.md
!runs/sparse/byte_check.log
!runs/sparse/factory_check.log
